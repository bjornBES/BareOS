
# debug or release
config = debug

target = 64
arch = x86_64
imageType = disk
imageFS = fat32
imageSize = 250m
toolchain = toolchains

# Mount methods:
# guestfs - uses libguestfs, doesn't require admin rights but may not work on some systems
# mount - uses mount, requires sudo
mountMethod = mount

# build
use_bios = 1

# kernel

max_path_length = 512
use_acpi = 0

## smp

enable_smp = 1

## mmu

enable_mmu = 1

## syscall

enable_syscall_fast_path = 1

# format: MMmmPPF
bareos_version = 0x0001000

# Minimum version POSIX.1 199009L released on September, 1990
# format: YYYYMML
POSIX_version = 202405L
use_POSIX_sys = 0

# Minimum version 1.0 / 1.0.9 released on March 14, 1994
# format: 0xMMmmPP
# linux_version = 0x010009
# use_linux_sys = 0

# Minimum version OpenBSD 1.0 released on October 1, 1996
# format: MAJOR*100+MINOR
# open_bsd_version = 100
# use_open_bsd_sys = 0

# Minimum version FreeBSD 1.0 released on November, 1993
# format: __FreeBSD_version-style
# free_bsd_version = 100000
# use_free_bsd_sys = 0

## vmm
use_eager_fork = 0

## modules
module_bsw = 1
module_la57 = 0

## scheduler
include_mlfq = 1
sched_algorithm = MLFQ

## process

process_max = 64
process_max_open_fd = 64
process_max_threads = 2
process_max_sections = 10

exec_max_args = 64

## loaders
loader_max_notes = 8
loader_max_interpreters = 8
loader_max_sections = 64
loader_max_symbols = 64
loader_max_section_name_length = 64

## debug
USE_LEVEL_1 = 1
USE_LEVEL_2 = 1
USE_LEVEL_3 = 1
USE_LEVEL_4 = 1
USE_LEVEL_5 = 1
config = debug
# debug or release

target = 64
arch = x86_64
imageType = disk
imageFS = fat32
imageSize = 250m
toolchain = ../.toolchains
max_path_length = 512

# Mount methods:
# guestfs - uses libguestfs, doesn't require admin rights but may not work on some systems
# mount - uses mount, requires sudo
mountMethod = mount

# build
use_bios = 1

# cpu

enable_multi_core = 1

# kernel
enable_paging = 1

## vmm
use_eager_fork = 0

## modules
module_bsw = 1
module_la57 = 0

## scheduler
include_mlfq = 1
sched_algorithm = MLFQ